---
/**
 * Swap point for the real lab mark.
 * Replace the square + serif "S" below with an inline SVG (or an <img>
 * from /public). Keep the same `logo` class so header, footer, and hero
 * watermark stay aligned. See README → “How to swap the logo”.
 */
interface Props {
  size?: number;
  class?: string;
}

const { size = 36, class: className } = Astro.props;
---

<span
  class:list={['logo', className]}
  style={`width:${size}px;height:${size}px`}
  aria-hidden="true"
>
  <span class="logo__s">S</span>
</span>

<style>
  .logo {
    display: inline-grid;
    place-items: center;
    flex: 0 0 auto;
    background: #000;
    color: #f2f3f4;
    line-height: 1;
  }

  .logo__s {
    font-family: Georgia, 'Times New Roman', Times, serif;
    font-size: 72%;
    font-weight: 400;
    transform: translateY(4%);
  }
</style>
